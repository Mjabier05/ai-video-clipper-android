@Composable
fun EditorScreen(uri: Uri, onBack: () -> Unit) {
    val context = LocalContext.current
    var totalDuration by remember { mutableStateOf(getVideoDurationMs(context, uri)) }
    var clipStart by remember { mutableStateOf(0L) }
    var clipEnd by remember { mutableStateOf(totalDuration.coerceAtLeast(1000L)) }
    var exportMessage by remember { mutableStateOf("") }
    var isExporting by remember { mutableStateOf(false) }

    LaunchedEffect(uri) {
        totalDuration = getVideoDurationMs(context, uri)
        clipStart = 0L
        clipEnd = totalDuration.coerceAtLeast(1000L)
    }

    val suggestions = remember(totalDuration) { generateAiSuggestions(totalDuration) }

    Scaffold(topBar = { AppTopBar(title = "Editor") }) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(16.dp)
        ) {
            VideoPreviewCard(uri = uri)

            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant)
            ) {
                Column(modifier = Modifier.padding(16.dp)) {
                    Text(text = "AI rekomendasi klip", style = MaterialTheme.typography.titleMedium)
                    Spacer(modifier = Modifier.height(8.dp))
                    suggestions.forEach { suggestion ->
                        Text(
                            text = "• ${suggestion.label}: ${formatDuration(suggestion.startMs)} - ${formatDuration(suggestion.endMs)}",
                            style = MaterialTheme.typography.bodyMedium
                        )
                    }
                }
            }

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                FeaturePill(Icons.Filled.AutoAwesome, "AI detect")
                FeaturePill(Icons.Filled.SmartDisplay, "Smart cut")
                FeaturePill(Icons.Filled.MusicNote, "Add music")
            }

            Divider()

            Text(
                text = "Trim video",
                style = MaterialTheme.typography.titleMedium,
                fontWeight = FontWeight.Bold
            )
            Text(text = "Mulai: ${formatDuration(clipStart)}   •   Akhir: ${formatDuration(clipEnd)}")

            if (totalDuration > 0L) {
                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                    Text("Start")
                    Slider(
                        value = clipStart.toFloat(),
                        onValueChange = { value ->
                            clipStart = value.toLong().coerceAtMost(clipEnd)
                        },
                        valueRange = 0f..totalDuration.toFloat(),
                        steps = 100
                    )

                    Text("End")
                    Slider(
                        value = clipEnd.toFloat(),
                        onValueChange = { value ->
                            clipEnd = value.toLong().coerceAtLeast(clipStart)
                        },
                        valueRange = 0f..totalDuration.toFloat(),
                        steps = 100
                    )
                }
            }

            Divider()

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                Button(onClick = onBack, modifier = Modifier.weight(1f)) {
                    Text("Back")
                }
                Button(
                    onClick = {
                        isExporting = true
                        exportTrimmedVideo(context, uri, clipStart, clipEnd) { success, message ->
                            isExporting = false
                            exportMessage = message
                            Toast.makeText(context, message, Toast.LENGTH_SHORT).show()
                        }
                    },
                    enabled = !isExporting,
                    modifier = Modifier.weight(1f)
                ) {
                    Text(if (isExporting) "Exporting..." else "Export")
                }
            }

            if (exportMessage.isNotEmpty()) {
                Text(
                    text = exportMessage,
                    color = if (exportMessage.contains("berhasil", ignoreCase = true))
                        MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.error,
                    style = MaterialTheme.typography.bodyMedium
                )
            }
        }
    }
}

@Composable
fun VideoPreviewCard(uri: Uri) {
    val context = LocalContext.current
    val exoPlayer = remember(context, uri) {
        ExoPlayer.Builder(context).build().apply {
            setMediaItem(MediaItem.fromUri(uri))
            prepare()
            playWhenReady = true
        }
    }

    DisposableEffect(exoPlayer) {
        onDispose { exoPlayer.release() }
    }

    Card(
        modifier = Modifier
            .fillMaxWidth()
            .height(240.dp),
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.primary.copy(alpha = 0.05f))
    ) {
        AndroidView(
            factory = { ctx ->
                PlayerView(ctx).apply {
                    player = exoPlayer
                    useController = true
                    setShowBuffering(PlayerView.SHOW_BUFFERING_ALWAYS)
                }
            },
            modifier = Modifier.fillMaxSize()
        )
    }
}

