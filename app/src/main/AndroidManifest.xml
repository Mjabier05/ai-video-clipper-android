@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun AppTopBar(title: String) {
    TopAppBar(title = { Text(title) })
}

fun exportTrimmedVideo(
    context: Context,
    sourceUri: Uri,
    startMs: Long,
    endMs: Long,
    callback: (Boolean, String) -> Unit
) {
    val sourceFile = copyUriToTempFile(context, sourceUri) ?: run {
        callback(false, "Gagal membaca file video")
        return
    }

    val outputDir = context.getExternalFilesDir(Environment.DIRECTORY_MOVIES)
        ?: context.cacheDir
    val outputFile = File(outputDir, "clip_${System.currentTimeMillis()}.mp4")

    val command = arrayOf(
        "-y",
        "-i", sourceFile.absolutePath,
        "-ss", (startMs / 1000.0).toString(),
        "-to", (endMs / 1000.0).toString(),
        "-c:v", "libx264",
        "-c:a", "aac",
        "-movflags", "+faststart",
        outputFile.absolutePath
    )

    FFmpegKit.executeAsync(command) { session ->
        val success = ReturnCode.isSuccess(session.returnCode.value)
        val message = if (success) {
            "Video berhasil diekspor ke ${outputFile.absolutePath}"
        } else {
            "Gagal mengekspor video: ${session.failStackTrace ?: "Unknown error"}"
        }
        callback(success, message)
    }
}

fun copyUriToTempFile(context: Context, uri: Uri): File? {
    val targetDir = File(context.cacheDir, "video_input")
    if (!targetDir.exists()) targetDir.mkdirs()

    val tempFile = File.createTempFile("clip_input_", ".mp4", targetDir)

    return try {
        context.contentResolver.openInputStream(uri)?.use { inputStream ->
            FileOutputStream(tempFile).use { outputStream ->
                inputStream.copyTo(outputStream)
            }
        }
        tempFile
    } catch (_: Exception) {
        null
    }
}

fun formatDuration(ms: Long): String {
    val totalSeconds = (ms / 1000L).coerceAtLeast(0)
    val minutes = totalSeconds / 60
    val seconds = totalSeconds % 60
    return String.format(Locale.getDefault(), "%02d:%02d", minutes, seconds)
}

fun getVideoDurationMs(context: Context, uri: Uri): Long {
    val retriever = MediaMetadataRetriever()
    return try {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            retriever.setDataSource(context, uri)
        } else {
            retriever.setDataSource(uri.toString())
        }
        val duration = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)?.toLongOrNull() ?: 0L
        duration.coerceAtLeast(0L)
    } catch (_: Exception) {
        0L
    } finally {
        retriever.release()
    }
}

fun generateAiSuggestions(durationMs: Long): List<ClipSegment> {
    if (durationMs <= 0L) {
        return listOf(
            ClipSegment(0L, 2000L, "Opening"),
            ClipSegment(2000L, 5000L, "Highlight")
        )
    }

    val chunk = durationMs / 4
    return listOf(
        ClipSegment(0L, chunk.coerceAtLeast(2000L), "Opening"),
        ClipSegment(chunk, chunk * 2, "Hook"),
        ClipSegment(chunk * 2, chunk * 3, "Highlight"),
        ClipSegment(chunk * 3, durationMs, "Call to action")
    )
}
